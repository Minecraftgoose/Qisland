/* qisland.rc — 程序图标 + 文件版本资源 + 进程清单（唯一的资源脚本） */
#include "version.h"

1 ICON "qisland.ico"
1 24 "qisland.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     QI_VERSION_NUM
    PRODUCTVERSION  QI_VERSION_NUM
    FILEFLAGSMASK   0x3f
    FILEFLAGS       0x0
    FILEOS          0x40004
    FILETYPE        0x1
    FILESUBTYPE     0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",       "Qisland"
            VALUE "FileDescription",   "Qisland Dynamic Island"
            VALUE "FileVersion",       QI_VERSION_STR
            VALUE "InternalName",      "Qisland"
            VALUE "LegalCopyright",    "See LICENSE and LICENSES"
            VALUE "OriginalFilename",  "Qisland.exe"
            VALUE "ProductName",       "Qisland"
            VALUE "ProductVersion",    QI_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
